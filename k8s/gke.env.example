# Copy to gke.env and fill in. gke.env is gitignored.
GCP_PROJECT_ID=
GKE_CLUSTER=
GKE_LOCATION=
GCP_REGION=
AR_REPOSITORY=repository-1
# After install-gke-gateway.sh: {GATEWAY_IP}.sslip.io  (not sslip.io)
INGRESS_DOMAIN=
GATEWAY_CLASS=gke-l7-global-external-managed
# Optional. If unset, the first deploy of a namespace generates a random password
# (Secret dating-app-db). Must be URL-safe: letters, digits, . _ ~ -
# POSTGRES_PASSWORD=
# Optional. Cluster-internal Postgres port (ConfigMap dating-app-config). Default 5432.
# POSTGRES_PORT=5432
